            <div style={{ fontSize: 11, color: "rgba(255,255,255,0.38)", marginBottom: 8, fontWeight: 500 }}>{card.label}</div>
            <div style={{ display: "flex", alignItems: "flex-end", gap: 8, marginBottom: 4 }}>
