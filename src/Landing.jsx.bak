      ctx.fillStyle = "#e2e8f0"; ctx.fillRect(260, 150, W - 280, 1);

      ctx.fillStyle = "#0f172a"; ctx.font = "bold 13px 'DM Sans',sans-serif";
      ctx.fillText("Demo — Rocketship", 275, 120);
      ctx.fillStyle = "#64748b"; ctx.font = "10px 'DM Sans',sans-serif";
