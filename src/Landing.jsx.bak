            { glow: "rgba(34,197,94,0.4)", border: "rgba(34,197,94,0.5)", bg: "rgba(34,197,94,0.05)", grad: "linear-gradient(135deg,rgba(34,197,94,0.12) 0%,rgba(16,185,129,0.07) 100%)" },
            { glow: "rgba(249,115,22,0.4)", border: "rgba(249,115,22,0.5)", bg: "rgba(249,115,22,0.05)", grad: "linear-gradient(135deg,rgba(249,115,22,0.12) 0%,rgba(234,179,8,0.07) 100%)" },
